{
  "Claude": {
    "url": "https://platform.claude.com/docs/en/about-claude/pricing.md",
    "start": "## Model pricing",
    "end": "*<sup>1",
    "pattern": "^\\| Claude (?<slug>(?:Fable|Mythos|Opus|Sonnet|Haiku) [\\d.]+)[^|]*\\|(?:[^|]*\\|){4} \\$(?<price>[\\d.]+) / MTok",
    "ignore": "^(Fable|Mythos) 5(\\.1)?$|^Opus (5|4|4\\.\\d)$|^Sonnet (5|4|4\\.\\d)$|^Haiku 4\\.5$"
  },
  "Codex": {
    "url": "https://developers.openai.com/api/docs/pricing.md",
    "start": "### Standard pricing data",
    "end": "| Model | Input | Output | Cached input |",
    "pattern": "^\\| gpt-[\\d.]+-(?<slug>[a-z]+) \\| \\$[\\d.]+ \\| \\$(?<price>[\\d.]+) \\|"
  },
  "Gemini": {
    "url": "https://ai.google.dev/gemini-api/docs/pricing.md.txt",
    "end": "## Pricing for tools",
    "pattern": "^## Gemini (?<slug>\\d[\\d.]* [A-Za-z-]+)\\s+\\{%[^\\n]*\\n(?:(?!\\n## )[\\s\\S])*?Output price[^\\n]*\\n\\s*\\*[^\\n]*\\n\\s*\\* \\$(?<price>[\\d.]+)",
    "ignore": "Transcribe|^[12]\\.|^3\\.1 "
  },
  "DeepSeek": {
    "url": "https://api-docs.deepseek.com/quick_start/pricing",
    "format": "html",
    "pattern": [
      "DeepSeek-(?<slug>V[\\d.]+-Flash)-\\d+[\\s\\S]*?1M OUTPUT TOKENS OFF-PEAK \\$[\\d.]+ \\$[\\d.]+ PEAK \\$(?<price>[\\d.]+) \\$[\\d.]+",
      "DeepSeek-(?<slug>V[\\d.]+-Pro)-\\d+[\\s\\S]*?1M OUTPUT TOKENS OFF-PEAK \\$[\\d.]+ \\$[\\d.]+ PEAK \\$[\\d.]+ \\$(?<price>[\\d.]+)"
    ]
  },
  "Kimi": {
    "url": "https://platform.kimi.com/docs/pricing/chat",
    "usdPerUnit": 0.14,
    "pattern": "children:`kimi-(?<slug>k[\\d.]+(?:-[a-z]+)?)`\\}\\),`¥[\\d.]+ / MTok`,`¥(?<price>[\\d.]+) / MTok`"
  }
}
