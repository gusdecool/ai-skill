#!/usr/bin/env bash
# Summarizes what one Claude Code worker session cost: wall minutes, tokens and an estimated dollar cost.
# Usage: board-run-stats <worktree-path> [--since <ISO time>] [--provider <name>] [--match <text>]
# Reads the session logs Claude Code keeps for that worktree (${BOARD_CLAUDE_PROJECTS:-~/.claude/projects}/<slug>/
# *.jsonl), counts each assistant message once, and prices the tokens with model-prices.tsv in the skill folder.
# Also reads the subagent logs (<session>/subagents/*.jsonl), so models used by Claude's own subagents are counted.
# With --provider codex it reads the Codex CLI logs instead
# (${BOARD_CODEX_SESSIONS:-~/.codex/sessions}/**/rollout-*.jsonl) whose working directory is <worktree-path>: the
# worker and every child agent it spawned (for example the
# codex-auto-review guardian) each get their own model entry, from the last token total in each log.
# With --provider antigravity --match <text> it reads the Antigravity CLI transcripts
# (${BOARD_ANTIGRAVITY_BRAIN:-~/.gemini/antigravity-cli/brain}/*/.system_generated/logs/transcript_full.jsonl) whose
# first user message contains <text> (the Orca task id of the worker): the transcript has no working directory.
# Prints one JSON object: {provider, startedAt, minutes, tokens, costUsd, models: [{model, label, input, output,
# cacheRead, cacheWrite, costUsd, priced}], unpriced: [model], markdown}. label is provider:model (from the label
# column of model-prices.tsv, else provider:<raw id>), safe for a Jira label.
# Exits 0, also with zeros when there are no logs (a stats failure must never block a ticket); exits 2 on bad arguments.
# Why logs and not Orca: Orca does not report tokens, but every Claude Code session writes per-message usage.
set -euo pipefail

# Prints an error and exits 2.
die() { echo "board-run-stats: $*" >&2; exit 2; }

USAGE="usage: board-run-stats <worktree-path> [--since <ISO time>] [--provider <name>] [--match <text>]"
[ "$#" -ge 1 ] || die "$USAGE"
worktree="$1"
shift
since="" provider="claude" match=""
while [ "$#" -gt 0 ]; do
  [ "$#" -ge 2 ] || die "$USAGE"
  case "$1" in
    --since) since="$2" ;;
    --provider) provider="$2" ;;
    --match) match="$2" ;;
    *) die "unknown option: $1" ;;
  esac
  shift 2
done
[[ -z "$since" || "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+(Z|[+-][0-9:]+)$ ]] || die "invalid --since: $since"

prices="$(dirname "${BASH_SOURCE[0]}")/../model-prices.tsv"

shopt -s nullglob
# Price table as JSON: {model: {in, out, cr, cw}}.
price_json="$(grep -v '^#' "$prices" | jq -Rn '[inputs | split("\t") | select(length >= 5)
  | {key: .[0], value: {in: (.[1] | tonumber), out: (.[2] | tonumber), cr: (.[3] | tonumber),
                        cw: (.[4] | tonumber), label: (.[5] // "")}}] | from_entries')"

# Prints one usage record per Codex log of the worktree: a start record with zero usage and an end record with the
# log's last token total (Codex input_tokens include the cached ones, so they are split into input and cacheRead).
codex_records() {
  local root="${BOARD_CODEX_SESSIONS:-$HOME/.codex/sessions}" f
  while IFS= read -r f; do
    jq -c -s --arg cwd "${worktree%/}" --arg id "$(basename "$f")" '
      (map(select(.type == "turn_context")) | first // {}) as $t
      | (map(select(.payload.type? == "token_count" and .payload.info != null)) | last
         | .payload.info.total_token_usage // null) as $u
      | select($t.payload.cwd == $cwd and $u != null)
      | ($t.payload.model // "unknown") as $m
      | ({id: ($id + "#start"), ts: .[0].timestamp, model: $m,
          u: {input_tokens: 0, output_tokens: 0, cache_read_input_tokens: 0, cache_creation_input_tokens: 0}},
         {id: $id, ts: .[-1].timestamp, model: $m,
          u: {input_tokens: (($u.input_tokens // 0) - ($u.cached_input_tokens // 0)),
              output_tokens: ($u.output_tokens // 0),
              cache_read_input_tokens: ($u.cached_input_tokens // 0),
              cache_creation_input_tokens: ($u.cache_write_input_tokens // 0)}})' "$f"
  done < <(grep -rl --include='rollout-*.jsonl' -F "\"cwd\":\"${worktree%/}\"" "$root" 2>/dev/null || true)
}

# Prints one usage record per model step of each Antigravity transcript whose first user message contains $match.
antigravity_records() {
  local root="${BOARD_ANTIGRAVITY_BRAIN:-$HOME/.gemini/antigravity-cli/brain}" f
  [ -n "$match" ] || die "--provider antigravity needs --match <text>"
  for f in "$root"/*/.system_generated/logs/transcript_full.jsonl; do
    jq -c -s --arg m "$match" --arg id "$(basename "$(dirname "$(dirname "$(dirname "$f")")")")" '
      select((map(select(.type == "USER_INPUT")) | first.content // "") | contains($m))
      | .[] | select(.model != null)
      | {id: ($id + "#" + (.step_index | tostring)), ts: .created_at, model: .model,
         u: {input_tokens: (.input_tokens // 0), output_tokens: (.output_tokens // 0),
             cache_read_input_tokens: (.cache_read_tokens // 0), cache_creation_input_tokens: 0}}' "$f"
  done
}

records="[]"
if [ "$provider" = antigravity ]; then
  records="$(antigravity_records | jq -s --arg since "$since" '[.[] | select($since == "" or .ts >= $since)]')"
elif [ "$provider" = codex ]; then
  records="$(codex_records | jq -s --arg since "$since" '[.[] | select($since == "" or .ts >= $since)]')"
else
  # Claude Code names the log folder after the path with every non-alphanumeric character replaced by '-'.
  slug="$(printf '%s' "${worktree%/}" | sed -E 's/[^A-Za-z0-9]/-/g')"
  dir="${BOARD_CLAUDE_PROJECTS:-$HOME/.claude/projects}/$slug"
  files=("$dir"/*.jsonl "$dir"/*/subagents/*.jsonl)
  if [ "${#files[@]}" -eq 0 ]; then
    echo "board-run-stats: no session logs in $dir" >&2
    files=()
  fi
  # One record per assistant message (the last copy wins, streaming repeats a message), then totals per model.
  if [ "${#files[@]}" -gt 0 ]; then
    records="$(cat "${files[@]}" | jq -cR 'fromjson? | select(.type == "assistant" and .message.usage != null)
      | {id: (.message.id // .uuid), ts: .timestamp, model: (.message.model // "unknown"), u: .message.usage}' |
      jq -s --arg since "$since" '[.[] | select($since == "" or .ts >= $since)]
        | group_by(.id) | map(.[-1])')"
  fi
fi

jq -n --argjson r "$records" --argjson p "$price_json" --arg provider "$provider" '
  def round($n): (. * pow(10; $n) | round) / pow(10; $n);
  ($r | map(.ts) | sort) as $ts
  | ($r | group_by(.model) | map(
      . as $g | $g[0].model as $m | ($p[$m]) as $pr
      | {model: $m,
         label: (if ($pr != null and $pr.label != "") then $pr.label
                 else ($provider + ":" + $m) | gsub("[^A-Za-z0-9._:-]"; "-") end),
         input: (map(.u.input_tokens // 0) | add), output: (map(.u.output_tokens // 0) | add),
         cacheRead: (map(.u.cache_read_input_tokens // 0) | add),
         cacheWrite: (map(.u.cache_creation_input_tokens // 0) | add)}
      | . + {priced: ($pr != null),
             costUsd: (if $pr == null then 0 else
               ((.input * $pr.in + .output * $pr.out + .cacheRead * $pr.cr + .cacheWrite * $pr.cw) / 1000000)
               end)})) as $models
  | {provider: $provider, startedAt: ($ts[0] // null),
     minutes: (if ($ts | length) < 2 then 0
               else (((($ts[-1] | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)
                       - ($ts[0] | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601)) / 60) | round(1)) end),
     tokens: ($models | map(.input + .output + .cacheRead + .cacheWrite) | add // 0),
     costUsd: ($models | map(.costUsd) | add // 0 | round(2)),
     models: ($models | map(.costUsd |= round(4))),
     unpriced: ($models | map(select(.priced | not) | .model))}
  | . + {markdown: (
      "Agent run (" + .provider + ")\n\n| Item | Value |\n|---|---|\n"
      + "| Wall time | " + (.minutes | tostring) + " min |\n"
      + "| Tokens | " + (.tokens | tostring) + " |\n"
      + "| Estimated cost | $" + (.costUsd | tostring)
      + (if (.unpriced | length) > 0 then " (excludes unpriced models)" else "" end) + " |\n"
      + (.models | map("| " + .label + " | " + ((.input + .output + .cacheRead + .cacheWrite) | tostring)
                       + " tokens, " + (if .priced then "$" + (.costUsd | tostring) else "price unknown" end)
                       + " |\n") | join(""))
      + "| Models | "
      + (if (.models | length) == 0 then "none" else (.models | map(.label) | join(", ")) end) + " |\n\n"
      + "Cost is an estimate: tokens times list price"
      + (if (.unpriced | length) > 0 then "; no price for " + (.unpriced | join(", ")) + " (counted as 0)" else "" end)
      + ".")}'
