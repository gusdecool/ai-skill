#!/usr/bin/env bash
# Watches Orca workers without a model and exits on the first event, so the orchestrator spends no tokens waiting.
# Usage: board-watch <dispatch>:<provider> [<dispatch>:<provider> ...]
# Prints one JSON line {event, dispatch, provider, reason, detail}. Exit 0: a worker settled (finished or failed).
# Exit 1: a worker is stuck, reason waiting_on_human (Orca says it is parked on a human prompt), limit_text (a usage or
# rate limit phrase in the last 15 screen lines), quota_cutoff (its provider is over the gd-load-balancer cutoff) or
# silent (screen unchanged for SILENT_SECONDS). Exit 2: Orca could not be read. Exit 3: WATCH_MAX_POLLS ran out (tests).
# Cutoffs are copied from skills/gd-load-balancer/SKILL.md: 90 session / 95 weekly, 80 / 75 for the reserved claude.
# Env: WATCH_INTERVAL (seconds between polls, default 600), SILENT_SECONDS (default 600), WATCH_MAX_POLLS (default
# unlimited), LIMIT_PATTERN (extended regex, case-insensitive), ORCA_BIN, ORCA_FALLBACK_BIN.
set -euo pipefail

dir="$(dirname "${BASH_SOURCE[0]}")"
source "$dir/orca-lib.sh"

[ "$#" -gt 0 ] || { echo "usage: board-watch <dispatch>:<provider> ..." >&2; exit 2; }

interval="${WATCH_INTERVAL:-600}"
silent_seconds="${SILENT_SECONDS:-600}"
max_polls="${WATCH_MAX_POLLS:-0}"
pattern="${LIMIT_PATTERN:-usage limit|rate limit|limit reached|hit your .*limit|try again at|out of (credits|usage)|quota (exceeded|exhausted)}"
orca="$(orca_bin)"
state="$(mktemp -d)"
trap 'rm -rf "$state"' EXIT

# Prints an error and exits 2 (Orca could not be read).
die() { echo "board-watch: $*" >&2; exit 2; }

# Prints the event as one JSON line and exits with the given code. Args: code, event, dispatch, provider, reason, detail.
finish() {
  jq -nc --arg e "$2" --arg d "$3" --arg p "$4" --arg r "$5" --arg t "$6" \
    '{event: $e, dispatch: $d, provider: $p, reason: $r, detail: $t}'
  exit "$1"
}

# Prints "session 90%, weekly 96%" for the windows of a provider that are over its cutoff, or nothing.
over_cutoff() {
  jq -r --arg p "$1" '
    (if $p == "claude" then {session: 80, weekly: 75} else {session: 90, weekly: 95} end) as $c
    | .result.rateLimits[$p] // empty | select(.status == "ok")
    | [(if .session != null and .session.usedPercent >= $c.session then "session \(.session.usedPercent)%" else empty end),
       (if .weekly != null and .weekly.usedPercent >= $c.weekly then "weekly \(.weekly.usedPercent)%" else empty end)]
    | join(", ")' <<<"$2"
}

# Checks one worker and finishes on an event. Args: index, dispatch, provider, accounts JSON.
check_worker() {
  local i="$1" id="$2" provider="$3" accounts="$4" show read tail line over sum now since
  show="$("$orca" orchestration worker-show --dispatch "$id" --json)" || die "cannot read worker $id"
  read="$("$orca" orchestration worker-read --dispatch "$id" --json --limit 40)" || die "cannot read output of $id"
  # A settled worker is reported first: it finished or failed, either way the orchestrator must look.
  if [ "$(jq -r '.result.stage // ""' <<<"$show")" = "settled" ]; then
    finish 0 settled "$id" "$provider" "" "$(jq -r '.result.state // ""' <<<"$show")"
  fi
  # Orca proved the worker is parked on a prompt only a human can answer (for example "switch model?").
  if [ "$(jq -r '.result.waitingOnHuman // ""' <<<"$show")" = "true" ]; then
    finish 1 stuck "$id" "$provider" waiting_on_human "parked on a prompt only a human can answer"
  fi
  tail="$(jq -r '[(.result.terminal.tail // [])[] | if type == "object" then (.text // .line // "") else tostring end]
    | .[-15:] | join("\n")' <<<"$read")"
  line="$(printf '%s\n' "$tail" | grep -i -E "$pattern" | tail -n 1 || true)"
  [ -z "$line" ] || finish 1 stuck "$id" "$provider" limit_text "$line"
  over="$(over_cutoff "$provider" "$accounts")"
  [ -z "$over" ] || finish 1 stuck "$id" "$provider" quota_cutoff "$over"
  # Silence: the same screen on a later poll, for at least SILENT_SECONDS since it last changed.
  sum="$(printf '%s' "$tail" | cksum | cut -d' ' -f1)"
  now="$(date +%s)"
  if [ -f "$state/$i.sum" ] && [ "$(cat "$state/$i.sum")" = "$sum" ]; then
    since="$(cat "$state/$i.since")"
    [ $((now - since)) -lt "$silent_seconds" ] \
      || finish 1 stuck "$id" "$provider" silent "no new output for $((now - since)) seconds"
  else
    printf '%s' "$sum" >"$state/$i.sum"
    printf '%s' "$now" >"$state/$i.since"
  fi
}

polls=0
while :; do
  accounts="$("$orca" account list --json)" || die "cannot read the provider quotas"
  i=0
  for spec in "$@"; do
    i=$((i + 1))
    check_worker "$i" "${spec%%:*}" "${spec#*:}" "$accounts"
  done
  polls=$((polls + 1))
  [ "$max_polls" -eq 0 ] || [ "$polls" -lt "$max_polls" ] || finish 3 none "" "" "" "no event after $polls polls"
  sleep "$interval"
done
