#!/usr/bin/env bash
# Decides whether the board worker should start a new worker now.
# Usage: board-precheck
# Exits 0 only when a pick-able Todo card exists, fewer than 2 cards are In progress (after reaping stale ones) and
# pick-provider --orchestrator exits 0 (claude, the orchestrator, has quota). Otherwise exits 1 with one line on stderr naming the failed condition; 2 on gh failure.
# Reaper: an In progress card whose issue and linked PRs show no activity for 2 hours gets the HITL label, moves to
# HITL and gets a comment with the last activity time, the 2-hour rule and the last PR seen.
# Activity is read per card: `gh issue view --json updatedAt` and `gh pr list --search "#<n>"` (PRs that mention it).
# Env: PICK_PROVIDER (path of pick-provider), NOW_EPOCH (clock in seconds, for tests), TODAY (passed to pick-next).
set -euo pipefail

dir="$(dirname "${BASH_SOURCE[0]}")"
source "$dir/board-lib.sh"

# Seconds of silence after which an In progress card counts as stale.
STALE_SECONDS=7200

# Appends a timestamped line to the precheck log (BOARD_PRECHECK_LOG, default ~/.config/board-worker/precheck.log).
# Best effort: a log write failure must not change precheck's exit code or its one stderr line.
log() {
  local file="${BOARD_PRECHECK_LOG:-$HOME/.config/board-worker/precheck.log}"
  { mkdir -p "$(dirname "$file")" && printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$file"; } 2>/dev/null || true
}

# Prints an error and exits 2 (gh or script failure, as opposed to a plain skip).
die() { log "exit 2: $*"; echo "board-precheck: $*" >&2; exit 2; }

# Prints one line naming the failed condition and exits 1.
fail() { log "exit 1: $*"; echo "board-precheck: $*" >&2; exit 1; }

# Prints the In progress issue cards as JSON lines.
in_progress_cards() {
  jq -c '.items[] | select(.status == "In progress" and .content.type == "Issue")' <<<"$1"
}

# Prints "<last activity ISO time> <last PR url or none>" for an issue, taking the latest of the issue and its PRs.
# Fails when the activity cannot be read, including an issue without an updatedAt.
last_activity() {
  local issue prs
  issue="$(gh issue view "$1" --json updatedAt)" || return 1
  prs="$(gh pr list --repo "$2" --state all --limit 100 --search "#$3 sort:updated-desc" \
    --json updatedAt,url)" || return 1
  jq -rn --argjson issue "$issue" --argjson prs "$prs" '
    if ($issue.updatedAt | type) != "string" then error("issue has no updatedAt") else . end
    | ([$prs[] | select(.updatedAt | type == "string")] | sort_by(.updatedAt) | last) as $pr
    | [$issue.updatedAt, $pr.updatedAt // empty] | max as $latest
    | "\($latest) \($pr.url // "none")"'
}

# Moves a stale card to HITL, then labels HITL, then comments why. Args: url, last-time, last-pr.
# The move comes first so a half-done reap still frees the slot; the comment last, as it bumps updatedAt.
# Returns 1 with a message when a step fails.
reap_card() {
  "$dir/board-set-status" "$1" HITL 2>/dev/null || { echo "cannot move $1 to HITL" >&2; return 1; }
  gh issue edit "$1" --add-label HITL >/dev/null || { echo "cannot label $1" >&2; return 1; }
  gh issue comment "$1" --body "No activity since $2 (no issue or PR update for 2 hours, the board worker rule), \
so this card was moved to the HITL column with the HITL label. Last PR seen: $3." >/dev/null \
    || { echo "cannot comment on $1" >&2; return 1; }
}

items="$(board_items)" || die "cannot list the board"
now="${NOW_EPOCH:-$(date +%s)}"
active=0
failed=""
while IFS= read -r card; do
  [ -n "$card" ] || continue
  url="$(jq -r '.content.url' <<<"$card")"
  repo="$(jq -r '.content.repository' <<<"$card")"
  number="$(jq -r '.content.number' <<<"$card")"
  # A card whose activity cannot be read, or of a foreign owner, counts as active and is never reaped.
  if board_owner_allowed "$repo" && info="$(last_activity "$url" "$repo" "$number")"; then
    last="${info%% *}"
    last_epoch="$(jq -rn --arg t "$last" '$t | fromdateiso8601')"
    if [ $((now - last_epoch)) -ge "$STALE_SECONDS" ]; then
      # A failed reap is remembered and reported at the end; the loop keeps going and the card still counts.
      if reap_card "$url" "$last" "${info#* }"; then continue; fi
      failed="$failed $url"
    fi
  fi
  active=$((active + 1))
done < <(in_progress_cards "$items")

[ -z "$failed" ] || die "could not reap:$failed"
[ "$active" -lt 2 ] || fail "$active cards are In progress, the limit is 2"
# Sub-script stderr is dropped so a skip prints exactly one line; exit 1 means "no", exit 2 means "cannot tell".
code=0
sub_err="$("$dir/board-pick-next" --dry-run 2>&1 >/dev/null)" || code=$?
[ "$code" -eq 0 ] || log "board-pick-next exited $code: $sub_err"
[ "$code" -ne 1 ] || fail "no pick-able Todo card"
[ "$code" -eq 0 ] || die "cannot read the board for a Todo card"
code=0
sub_err="$("${PICK_PROVIDER:-$dir/pick-provider}" --orchestrator 2>&1 >/dev/null)" || code=$?
[ "$code" -eq 0 ] || log "pick-provider exited $code: $sub_err"
[ "$code" -ne 1 ] || fail "no provider has quota left for the orchestrator (claude)"
[ "$code" -eq 0 ] || die "cannot read the provider quotas"
