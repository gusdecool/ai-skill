#!/usr/bin/env bash
# Checks the ticket's tagged plan and, for multiple tasks, its dispatch comment before product edits. The comment must
# hold the load-balancer score table (a `| Provider |` header and a chosen row), so a reviewer sees the formula ran.
# Usage: board-plan-check <ticket-key>; exits 0 on success or 1 with one diagnostic line on failure.
set -euo pipefail

# Suppress library diagnostics so every failure has exactly one line.
lib="$(dirname "${BASH_SOURCE[0]}")/board-lib.sh"
(source "$lib") 2>/dev/null || { echo 'board-plan-check: invalid config' >&2; exit 1; }
source "$lib"
# Reports a failed gate without exposing Jira response details.
fail() { echo "board-plan-check: $*" >&2; exit 1; }
[ "$#" -eq 1 ] || fail 'usage: board-plan-check <ticket-key>'
key="$(jira_key "$1")" || fail 'invalid ticket key'
[[ "$1" == "$key" ]] || fail 'use a ticket key'

# Require one matching plan, so an unrelated or ambiguous plan cannot pass the gate.
plans=()
for file in docs/superpowers/plans/*.md; do
  [ -f "$file" ] || continue
  case "$(basename "$file")" in *"-$key-"* | *"-$key.md") plans+=("$file") ;; esac
done
[ "${#plans[@]}" -eq 1 ] || fail 'expected exactly one plan with the ticket key in its filename'
counts="$(awk '
  /^### Task [0-9]+([:[:space:]]|$)/ {
    total++
    if ($0 ~ /\((mechanical|judgment)\)[[:space:]]*$/) tagged++
  }
  END { print total+0, tagged+0 }
' "${plans[0]}")"
read -r total tagged <<<"$counts"
[ "$total" -gt 0 ] && [ "$total" -eq "$tagged" ] || fail 'plan tasks must all be tagged mechanical or judgment'
[ "$total" -ge 2 ] || exit 0

# Follow every Jira comment page; fail closed if the response is incomplete or unreadable.
start=0
while :; do
  page="$(jira_api GET "/rest/api/2/issue/$key/comment?startAt=$start&maxResults=100" 2>/dev/null)" \
    || fail 'cannot read ticket comments'
  jq -e '.comments | type == "array"' <<<"$page" >/dev/null 2>&1 || fail 'invalid ticket comments'
  if jq -e '.comments[] | select((.body | type) == "string" and (.body | contains("Dispatch:"))
    and (.body | contains("| Provider |")) and (.body | contains("| chosen |")))' \
    <<<"$page" >/dev/null 2>&1; then exit 0; fi
  count="$(jq '.comments | length' <<<"$page")"
  total_comments="$(jq -r '.total // empty' <<<"$page")"
  [[ "$total_comments" =~ ^[0-9]+$ ]] || fail 'invalid ticket comments'
  start=$((start + count))
  [ "$start" -lt "$total_comments" ] || fail 'missing Dispatch: comment with the pick-provider score table'
  [ "$count" -gt 0 ] || fail 'incomplete ticket comments'
done
