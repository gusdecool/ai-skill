#!/usr/bin/env bash
# Checks that a human approved the merge of this ticket by ticking its "Auto merge" checkbox field in Jira.
# Usage: board-check-merge-approved <ticket-key-or-browse-url>
# Approved = the custom field named "Auto merge" has the option "Yes" ticked. The description and comments are never
# read, so text written there cannot grant approval; only someone who can edit the field can.
# Prints {"approved":bool,"reason":"..."}; exits 0 when approved, 1 when not, 2 when the ticket cannot be read.
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/board-lib.sh"

# Prints an error and exits 2.
die() { echo "board-check-merge-approved: $*" >&2; exit 2; }

# Prints the verdict JSON and exits 0 (approved) or 1 (not approved). Args: true|false, reason.
verdict() {
  jq -n -c --argjson approved "$1" --arg reason "$2" '{approved: $approved, reason: $reason}'
  [ "$1" = true ]
  exit $?
}

[ "$#" -eq 1 ] || die "usage: board-check-merge-approved <ticket-key-or-browse-url>"
# Loads the Jira config first so a browse URL is checked against the configured site.
jira_load_config || exit 2
key="$(jira_key "$1")" || die "not a ticket key or URL: $1"

# Finds the custom field by name; none or several matches means the approval cannot be decided.
fields="$(jira_api GET /rest/api/2/field)" || exit 2
matches="$(jq -r '[.[] | select(.name == "Auto merge" and .custom == true) | .id | tostring] | join("\n")' \
  <<<"$fields")" || die "cannot parse the field list"
[ -n "$matches" ] || die "no custom field named 'Auto merge'"
[ "$(wc -l <<<"$matches")" -eq 1 ] || die "more than one custom field named 'Auto merge'"
field="$matches"
[[ "$field" =~ ^customfield_[0-9]+$ ]] || die "unexpected field id: $field"

# Reads only that field; it is a checkbox, so an array of options, or null when nothing is ticked.
json="$(jira_api GET "/rest/api/2/issue/$key?fields=$field")" || exit 2
ticked="$(jq -r --arg f "$field" \
  '(.fields[$f]) as $v | if ($v | type) == "array" and any($v[]; type == "object" and .value == "Yes")
   then "yes" else "no" end' <<<"$json")" || die "cannot parse the ticket $key"

[ "$ticked" = yes ] || verdict false "the 'Auto merge' field is not ticked"
verdict true "the 'Auto merge' field is ticked"
