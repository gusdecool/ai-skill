#!/usr/bin/env bash
# Picks the provider and model for the next worker, by remaining quota, at the asked tier (default Mid).
# Usage: pick-provider [--tier Low|Mid|High|Ultra] [--orchestrator]
# A provider whose models.md cell for the tier is `none` is skipped; the tier is never swapped. Only the Mid model ids
# are held here, so another tier with a model in the table exits 2 until its id is added.
# --orchestrator considers only claude (the session that runs the ticket) and needs it under its reserved cutoffs.
# Prints {"provider","model","tier"} and exits 0, or {"error","earliestResetsAt"} and exits 1 when every provider is
# over a cutoff or unavailable. Exits 2 when quotas cannot be read.
# Rules and numbers are copied from skills/load-balancer/SKILL.md: cutoffs 90 session / 95 weekly (80 / 75 for the
# reserved provider, claude, which runs this skill); urgency = remaining / max(timeLeftFraction, 0.05) per window;
# the highest window urgency is the score (the load-balancer's "+5 session points per parallel task" rule is
# omitted: this script starts one worker at a time); a provider with neither window is dropped; scores within 5
# percent tie and go to claude, then to the listed order.
# Env: MODELS_FILE (default: global/models.md in AGENT_STANDARDS_DIR, default ~/Developer/gusdecool/agent-standards),
# ORCA_BIN (default: orca from PATH, else ORCA_FALLBACK_BIN), ORCA_FALLBACK_BIN (default: the Orca app's bin),
# CODEX_MODELS_CACHE (default ~/.codex/models_cache.json), NOW_MS (clock, for tests).
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/orca-lib.sh"

# Prints the highest visible Sol model slug from the Codex models cache (compared by version number).
codex_model() {
  jq -r '[.models[] | select(.visibility == "list")
          | (.slug | capture("^gpt-(?<v>[0-9.]+)-sol$")?) as $m | select($m)
          | {slug: .slug, v: ($m.v | split(".") | map(tonumber))}]
         | sort_by(.v) | last | .slug // empty' "${CODEX_MODELS_CACHE:-$HOME/.codex/models_cache.json}"
}

# Prints the models.md cell for provider $1 (table row name) and tier $2 (Low, Mid, High or Ultra).
table_cell() {
  awk -F'|' -v row="$1" -v tier="$2" '
    function trim(x) { gsub(/^ +| +$/, "", x); return x }
    trim($2) == "Provider" { for (i = 3; i <= NF; i++) if (trim($i) == tier) col = i }
    trim($2) == row && col { print trim($col); exit }' "$models_file"
}

orchestrator=false
tier=Mid
while [ $# -gt 0 ]; do
  case "$1" in
    --orchestrator) orchestrator=true ;;
    --tier) shift; tier="${1:-}" ;;
    *) echo "pick-provider: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done
case "$tier" in
  Low | Mid | High | Ultra) ;;
  *) echo "pick-provider: unknown tier '$tier' (use Low, Mid, High or Ultra)" >&2; exit 2 ;;
esac
models_file="${MODELS_FILE:-${AGENT_STANDARDS_DIR:-$HOME/Developer/gusdecool/agent-standards}/global/models.md}"

accounts="$("$(orca_bin)" account list --json)" || { echo "pick-provider: cannot read quotas" >&2; exit 2; }
now_ms="${NOW_MS:-$(($(date +%s) * 1000))}"

# Keep only the three known providers, in listed order, scored; blocked ones carry the time they free up.
result="$(jq -c --argjson now "$now_ms" '
  def cutoffs($p): if $p == "claude" then {session: 80, weekly: 75} else {session: 90, weekly: 95} end;
  def urgency($w): (100 - $w.usedPercent)
    / ([($w.resetsAt - $now) / ($w.windowMinutes * 60000), 0.05] | max);
  [.result.rateLimits | to_entries[] | select(.key | IN("claude", "codex", "antigravity"))
   | select(.value.status == "ok") | .key as $p | cutoffs($p) as $c
   | [{n: "session", w: .value.session}, {n: "weekly", w: .value.weekly}] | map(select(.w != null)) as $ws
   | select(($ws | length) > 0)
   | ($ws | map(select(.w.usedPercent >= $c[.n]))) as $blocked
   | {provider: $p,
      freeAt: ($blocked | map(.w.resetsAt) | max),
      score: ($ws | map(urgency(.w)) | max)}]' <<<"$accounts")"

# For the orchestrator only claude counts; the rest of the script then works unchanged.
if [ "$orchestrator" = true ]; then result="$(jq -c 'map(select(.provider == "claude"))' <<<"$result")"; fi

# Drop providers that have no model in the asked tier. Mid is the baseline every provider fills, so a missing table
# is only fatal for the other tiers.
if [ ! -r "$models_file" ] && [ "$tier" != "Mid" ]; then
  echo "pick-provider: cannot read $models_file to check tier $tier" >&2; exit 2
fi
if [ -r "$models_file" ]; then
  kept="[]"
  for p in $(jq -r '.[].provider' <<<"$result"); do
    case "$p" in claude) row=Claude ;; codex) row=Codex ;; antigravity) row=Gemini ;; esac
    if [ "$(table_cell "$row" "$tier")" = "none" ]; then
      echo "pick-provider: $p has no $tier model in models.md" >&2
    else
      kept="$(jq -c --arg p "$p" '. + [$p]' <<<"$kept")"
    fi
  done
  result="$(jq -c --argjson k "$kept" 'map(select(.provider as $p | $k | index($p)))' <<<"$result")"
  if [ "$(jq length <<<"$result")" -eq 0 ]; then
    jq -nc --arg t "$tier" '{error: ("no provider has a " + $t + " model")}'
    exit 1
  fi
fi

eligible="$(jq -c '[.[] | select(.freeAt == null)]' <<<"$result")"
if [ "$(jq length <<<"$eligible")" -eq 0 ]; then
  jq -c '{error: "all providers over cutoff", earliestResetsAt: (map(.freeAt) | min)}' <<<"$result"
  exit 1
fi

# Highest score wins; within 5 percent of it, claude wins, else the first listed.
provider="$(jq -r '(map(.score) | max) as $top | [.[] | select(.score >= $top * 0.95)]
  | (map(select(.provider == "claude")) + .)[0].provider' <<<"$eligible")"

if [ "$tier" != "Mid" ]; then
  echo "pick-provider: no model id is held for $provider at tier $tier" >&2; exit 2
fi
case "$provider" in
  claude) model="claude-sonnet-5-5" ;;
  codex) model="$(codex_model)"; [ -n "$model" ] || { echo "pick-provider: no Sol model in cache" >&2; exit 2; } ;;
  antigravity) model="gemini-3.8-flash" ;;
esac
jq -nc --arg p "$provider" --arg m "$model" --arg t "$tier" '{provider: $p, model: $m, tier: $t}'
