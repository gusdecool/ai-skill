#!/usr/bin/env bash
# Prevents unpinned model inheritance and requests approval for non-default tiers.
set -euo pipefail
set -E

# Deny without jq because an empty hook response would allow the dispatch through.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny",' \
    '"permissionDecisionReason":"jq is required by the gusdecool-model-policy guard."}}'
  exit 0
fi

# Emits the Claude permission envelope, always with a successful hook exit status.
decision() {
  jq -nc --arg result "$1" --arg reason "$2" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:$result,
      permissionDecisionReason:$reason}}'
  exit 0
}

# Turns parsing and filesystem failures into a refusal rather than allowing inheritance.
# shellcheck disable=SC2317,SC2329 # invoked by the ERR trap
malformed() {
  trap - ERR
  decision deny 'Invalid model hook input; load gusdecool-model-policy before dispatching a subagent.'
}
trap malformed ERR

# Validate the payload before allowing unrelated tools through.
input="$(cat)"
jq -e -s 'length == 1 and (.[0] | type == "object" and
  (.tool_name | type == "string" and length > 0))' <<<"$input" >/dev/null
name="$(jq -r .tool_name <<<"$input")"
case "$name" in Agent|Task) ;; *) exit 0 ;; esac
jq -e '.tool_input | type == "object" and
  ((has("model") | not) or (.model | type == "string")) and
  ((has("subagent_type") | not) or (.subagent_type | type == "string"))' <<<"$input" >/dev/null
jq -e '(has("cwd") | not) or (.cwd | type == "string")' <<<"$input" >/dev/null
agent="$(jq -r '.tool_input.subagent_type // ""' <<<"$input")"
model="$(jq -r '.tool_input.model // ""' <<<"$input")"
cwd="$(jq -r '.cwd // ""' <<<"$input")"

# Forks always need approval, even when the call names an allowed model.
if [ "$agent" = fork ]; then
  decision ask 'Fork dispatch needs approval; load gusdecool-model-policy before continuing.'
fi

# Explicit models override project and user definitions; project definitions take precedence.
if [ -z "$model" ] && [ -n "$agent" ]; then
  case "$agent" in
    *[!a-zA-Z0-9_-]*)
      reason='This agent type has no local definition to read a model from; '
      reason+='pass model sonnet or haiku explicitly and load gusdecool-model-policy.'
      decision deny "$reason"
      ;;
  esac
  definition="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}/$agent.md"
  if [ -n "$cwd" ] && [ -f "$cwd/.claude/agents/$agent.md" ]; then
    definition="$cwd/.claude/agents/$agent.md"
  fi
  if [ -f "$definition" ]; then
    model="$(awk '
      NR == 1 { if ($0 != "---") exit; next }
      /^---[[:space:]]*$/ { exit }
      /^model:[[:space:]]*/ {
        sub(/^model:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit
      }
    ' "$definition")"
  fi
fi

# Only the default tiers bypass approval; a missing pin must never inherit the session model.
case "$model" in
  haiku|sonnet) exit 0 ;;
  '') decision deny 'The subagent would inherit the session model; load gusdecool-model-policy and pin its model.' ;;
  *) decision ask 'This model needs approval; load gusdecool-model-policy before dispatching the subagent.' ;;
esac
