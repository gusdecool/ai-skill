#!/usr/bin/env bash
# The single deterministic check before a board worker may merge its PR.
# Usage: board-merge-gate <ticket-key-or-browse-url> <pr-number>
# Prints {"allowed":bool,"repo":"owner/repo","blocked":["reason",...]}; exits 0 only when every check passes, 1 when
# any blocks the merge, 2 when something cannot be read (treat as blocked). The repo is the ticket's single component,
# named owner/repo ("" when there is none); the caller must merge the PR in exactly that repo.
# Checks, all by script so ticket text cannot talk past them:
#   1. the repo owner is in BOARD_ALLOWED_OWNERS         2. the repo visibility is not in BOARD_BLOCKED_VISIBILITIES
#   3. the ticket's "Auto merge" checkbox field is ticked (board-check-merge-approved)
#   4. the PR changes no CI/CD file (always a human), and no infra file unless BOARD_ALLOW_INFRA_CHANGE=true
#   5. the PR in that repo is open and its branch starts with "<ticket key>-", so the component cannot point at
#      an unrelated PR with the same number (checked before 4; if it blocks, 4 is skipped)
# Without a valid component, checks 1, 2, 4 and 5 are skipped and the merge is blocked.
set -euo pipefail

dir="$(dirname "${BASH_SOURCE[0]}")"
source "$dir/board-lib.sh"

# Prints an error and exits 2.
die() { echo "board-merge-gate: $*" >&2; exit 2; }

[ "$#" -eq 2 ] || die "usage: board-merge-gate <ticket-key-or-browse-url> <pr-number>"
ticket="$1" pr="$2"
[[ "$pr" =~ ^[0-9]+$ ]] || die "not a PR number: $pr"
# Loads the Jira config first so a browse URL is checked against the configured site.
jira_load_config || exit 2
key="$(jira_key "$ticket")" || die "not a ticket key or URL: $ticket"

# Reads the components; jira_api has already printed any failure.
json="$(jira_api GET "/rest/api/2/issue/$key?fields=components")" || exit 2
repo="$(jq -r 'if (.fields.components | type) == "array" and (.fields.components | length) == 1
  then (.fields.components[0].name // "") else "" end' <<<"$json")" || die "cannot parse the components of $key"
have_repo=true
[[ "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || have_repo=false
[ "$have_repo" = true ] || repo=""

blocked=()
if [ "$have_repo" = true ]; then
  # 1. Owner allow-list.
  board_owner_allowed "$repo" || blocked+=("repo owner is not in the allowed owners")
  # 2. Visibility; an unreadable one blocks too.
  rc=0; board_visibility_blocked "$repo" || rc=$?
  case "$rc" in
    0) blocked+=("repo visibility is blocked by the gusdecool-board-worker config") ;;
    1) ;;
    *) blocked+=("repo visibility could not be read") ;;
  esac
else
  blocked+=("the ticket must have exactly one component named owner/repo")
fi
# 3. Human approval: the ticket's Auto merge checkbox. Exit 0 must also say approved, so anything odd blocks.
rc=0; approval="$("$dir/board-check-merge-approved" "$key" 2>/dev/null)" || rc=$?
case "$rc" in
  0) [ "$(jq -r '.approved' <<<"$approval" 2>/dev/null)" = true ] || blocked+=("approval could not be read") ;;
  1) blocked+=("$(jq -r '.reason // "approval could not be read"' <<<"${approval:-null}" 2>/dev/null ||
    echo "approval could not be read")") ;;
  *) blocked+=("approval could not be read") ;;
esac
# 5. The PR must be open in this repo and on this ticket's branch; without that there is nothing to trust.
pr_ok=false
if [ "$have_repo" = true ]; then
  pr_json="$(gh pr view "$pr" --repo "$repo" --json headRefName,state 2>/dev/null)" || pr_json=""
  state="$(jq -er '.state | strings' <<<"$pr_json" 2>/dev/null)" || state=""
  branch="$(jq -er '.headRefName | strings' <<<"$pr_json" 2>/dev/null)" || branch=""
  if [ -z "$state" ] || [ -z "$branch" ]; then
    blocked+=("the PR could not be read in $repo")
  elif [ "$state" != OPEN ]; then
    blocked+=("the PR is not open")
  elif [ "${branch:0:$((${#key} + 1))}" != "$key-" ]; then
    blocked+=("the PR branch does not belong to this ticket (it must start with $key-)")
  else
    pr_ok=true
  fi
fi
# 4. CI/CD and infra changes; they need a repo and a PR that passed check 5.
if [ "$pr_ok" = true ]; then
  rc=0; diff_json="$("$dir/board-check-diff" "$pr" "$repo")" || rc=$?
  if [ "$rc" -eq 2 ]; then
    blocked+=("the PR file list could not be read")
  else
    [ "$(jq -r .cicd <<<"$diff_json")" != true ] ||
      blocked+=("the PR changes CI/CD files, which always need a human: $(jq -r '.paths | join(", ")' <<<"$diff_json")")
    if [ "$(jq -r .infra <<<"$diff_json")" = true ] && [ "$BOARD_ALLOW_INFRA_CHANGE" != true ]; then
      blocked+=("the PR changes infrastructure files and BOARD_ALLOW_INFRA_CHANGE is not true")
    fi
  fi
fi

allowed=true
[ "${#blocked[@]}" -eq 0 ] || allowed=false
printf '%s\n' "${blocked[@]+"${blocked[@]}"}" | jq -R -s -c --argjson allowed "$allowed" --arg repo "$repo" \
  'split("\n") | map(select(length > 0)) | {allowed: $allowed, repo: $repo, blocked: .}'
[ "$allowed" = true ]
